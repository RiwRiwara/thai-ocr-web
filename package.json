{
  "name": "thai-ocr-web",
  "version": "0.1.1",
  "description": "Thai + English printed-text OCR in the browser (WebGPU / WASM), images and PDFs: a JavaScript port of OpenThai 2.1 OCR Text with output identical to the reference runtime",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Awirut",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiwRiwara/thai-ocr-web.git"
  },
  "homepage": "https://thai-ocr-web.pages.dev/",
  "bugs": {
    "url": "https://github.com/RiwRiwara/thai-ocr-web/issues"
  },
  "keywords": [
    "ocr",
    "thai",
    "thai-ocr",
    "ocr-thai",
    "browser",
    "wasm",
    "webgpu",
    "onnxruntime-web",
    "paddleocr",
    "openthai",
    "text-recognition",
    "pdf",
    "pdfjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./pdf": {
      "types": "./src/pdf.d.ts",
      "default": "./src/pdf.js"
    },
    "./models/*": "./models/*",
    "./vendor/opencv/opencv-ocr.mjs": "./vendor/opencv/opencv-ocr.mjs",
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "vendor/opencv/opencv-ocr.mjs",
    "models",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/parity.mjs && node test/pdf.mjs",
    "dev": "node scripts/prepare-demo.mjs && vite",
    "build": "node scripts/prepare-demo.mjs && vite build && node scripts/split-large-assets.mjs",
    "preview": "vite preview",
    "build:opencv": "bash vendor/opencv/build/build.sh"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": ">=5"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "coi-serviceworker": "^0.1.7",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "pngjs": "^7.0.0",
    "vite": "^8.3.8"
  }
}
